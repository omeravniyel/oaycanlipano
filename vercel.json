{
    "rewrites": [
        {
            "source": "/super-admin",
            "destination": "/admin.html"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/canli",
            "destination": "/canli.html"
        },
        {
            "source": "/yayin",
            "destination": "/broadcast.html"
        },
        {
            "source": "/board",
            "destination": "/board.html"
        },
        {
            "source": "/",
            "destination": "/index.html"
        },
        {
            "source": "/panel.html",
            "destination": "/panel.html"
        },
        {
            "source": "/setup-db.html",
            "destination": "/setup-db.html"
        },
        {
            "source": "/debug_db.html",
            "destination": "/debug_db.html"
        },
        {
            "source": "/test-login.html",
            "destination": "/test-login.html"
        },
        {
            "source": "/cleanup-storage.html",
            "destination": "/cleanup-storage.html"
        },
        {
            "source": "/:slug/admin",
            "destination": "/panel.html"
        },
        {
            "source": "/sayim",
            "destination": "/sayim.html"
        },
        {
            "source": "/((?!api/|js/|css/|img/|sayim\\.html|admin\\.html|debug\\.html|panel\\.html|board\\.html|super-admin|favicon\\.ico).*)",
            "destination": "/api/serve-board?path=$1"
        }
    ]
}