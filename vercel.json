{
    "crons": [
        {
            "path": "/api/cron-reminder",
            "schedule": "0 17 * * 0"
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/canli",
            "destination": "/canli.html"
        },
        {
            "source": "/yayin",
            "destination": "/broadcast.html"
        },
        {
            "source": "/admin",
            "destination": "/admin.html"
        },
        {
            "source": "/board",
            "destination": "/board.html"
        },
        {
            "source": "/",
            "destination": "/index.html"
        },
        {
            "source": "/admin.html",
            "destination": "/admin.html"
        },
        {
            "source": "/super-admin",
            "destination": "/admin.html"
        },
        {
            "source": "/super-admin.html",
            "destination": "/admin.html"
        },
        {
            "source": "/panel.html",
            "destination": "/panel.html"
        },
        {
            "source": "/setup-db.html",
            "destination": "/setup-db.html"
        },
        {
            "source": "/debug_db.html",
            "destination": "/debug_db.html"
        },
        {
            "source": "/:slug/admin",
            "destination": "/panel.html"
        },
        {
            "source": "/(.*)",
            "destination": "/api/serve-board?path=$1"
        }
    ]
}